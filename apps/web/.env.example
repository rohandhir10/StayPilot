# Browser-visible Firebase Web App settings. Firebase web API keys are not server secrets.
VITE_API_BASE_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# Only set true for Vercel Preview deployments that should display the read-only sample dashboard.
VITE_PREVIEW_MODE=false
