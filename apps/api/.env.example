# Required
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://staypilot:replace-me@localhost:5432/staypilot
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_FROM_CLERK_DASHBOARD
CLERK_SECRET_KEY=sk_test_REPLACE_FROM_CLERK_DASHBOARD
OWNER_CLERK_USER_ID=user_REPLACE_WITH_THE_OWNER_CLERK_USER_ID
WEB_ORIGINS=http://localhost:5173

# Public API origin used to construct provider OAuth redirect URIs (no trailing slash).
PUBLIC_API_URL=http://localhost:3000

# Email OAuth providers (optional until Gmail/Outlook is enabled).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Generate with: openssl rand -base64 32. Keep stable; rotating it requires reconnecting all provider accounts.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Optional, required before enabling those features
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Operational settings
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
RATE_LIMIT_PUBLIC_PER_HOUR=5
RATE_LIMIT_PARTNER_PER_MINUTE=120
WEBHOOK_BODY_LIMIT_BYTES=1048576
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Do not commit real values. Set them in Railway (API service) or Vercel (frontend) project settings.
