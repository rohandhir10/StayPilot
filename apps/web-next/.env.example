# Next.js / Auth.js application
AUTH_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Must exactly match the Fastify API values; never expose these as NEXT_PUBLIC variables.
API_AUTH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_TOKEN_ISSUER=https://staypilot.app
API_BASE_URL=https://your-railway-api-origin.example

# Enable only on a controlled test deployment. The API must use matching values.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_EMAIL=test@staypilot.demo
TEST_LOGIN_PASSWORD_HASH=
