{
  "name": "@staypilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node -r dotenv/config --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node -r dotenv/config --import tsx src/migrate.ts",
    "cleanup": "node -r dotenv/config --import tsx src/cleanup.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:prod": "node dist/migrate.js",
    "cleanup:prod": "node dist/cleanup.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76",
    "dotenv": "^17.2.2",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
