# Required
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://staypilot:replace-me@localhost:5432/staypilot
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the complete Firebase service-account JSON into the Railway secret variable; do not commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Copy the signed-in owner's Firebase Authentication UID from Firebase Console > Authentication > Users.
OWNER_FIREBASE_UID=
WEB_ORIGINS=http://localhost:5173

# Optional, but required before enabling those features
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Operational settings
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA certificate for databases using a private/self-signed CA.
# Keep certificate verification enabled; for the stock Railway Postgres image set this to the exported root CA PEM.
DATABASE_SSL_CA=
# Optional TLS identity override when the certificate SAN differs from the private Railway hostname (stock image: localhost).
DATABASE_SSL_SERVERNAME=
RATE_LIMIT_PUBLIC_PER_HOUR=5
RATE_LIMIT_PARTNER_PER_MINUTE=120
WEBHOOK_BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info

# Do not commit real values. Set them in Railway (API service) or Vercel (frontend) project settings.
