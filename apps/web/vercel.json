{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund",
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/inquiry", "destination": "/inquiry.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
