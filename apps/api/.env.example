# Required
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://staypilot:replace-me@localhost:5432/staypilot
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_FROM_CLERK_DASHBOARD
CLERK_SECRET_KEY=sk_test_REPLACE_FROM_CLERK_DASHBOARD
OWNER_CLERK_USER_ID=user_REPLACE_WITH_THE_OWNER_CLERK_USER_ID
WEB_ORIGINS=http://localhost:5173

# Optional, but required before enabling those features
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Mailbox OAuth is disabled until real provider app credentials and API origin are configured.
API_PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32. Keep secret in Railway only.
OAUTH_TOKEN_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Operational settings
# Use only provider-confirmed reverse-proxy IPs/CIDRs; do not use 0.0.0.0/0 or ::/0.
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
RATE_LIMIT_PUBLIC_PER_HOUR=5
RATE_LIMIT_PARTNER_PER_MINUTE=120
WEBHOOK_BODY_LIMIT_BYTES=1048576
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info

# Do not commit real values. Set them in Railway (API service) or Vercel (frontend) project settings.
